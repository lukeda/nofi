main.mx-auto.max-w-md.space-y-5.p-6
  header.flex.items-center.justify-between
    h1 Settings
    button Save
  section.space-y-3
    h2 Account
    label.block(for="name") Name
    input.w-full(id="name" value="Alex Morgan")
    label.block(for="email") Email
    input.w-full(id="email" value="alex@example.com")
  section.space-y-3.border-t.pt-4
    h2 Notifications
    label.flex.items-center.gap-3
      input(type="checkbox" checked)
      span Email updates
    label.flex.items-center.gap-3
      input(type="checkbox")
      span Product news
